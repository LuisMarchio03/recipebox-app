# Configuração do Banco (Turso ou SQLite local)
# Para Turso: DATABASE_URL=libsql://seu-banco.turso.io
# Para SQLite local: DATABASE_URL=file:./data.db
DATABASE_URL=file:./data.db

# Token de autenticação do Turso (apenas se usar Turso)
TURSO_AUTH_TOKEN=

# Segredo para JWT
JWT_SECRET=seu-segredo-aqui-mude-em-producao

# Porta do servidor
PORT=3000
