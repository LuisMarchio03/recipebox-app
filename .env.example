# ─────────────────────────────────────────────────────────────
# Banco de dados (libSQL / Turso ou SQLite local)
# ─────────────────────────────────────────────────────────────
# Local:  file:./data.db
# Turso:  libsql://seu-banco.turso.io
DATABASE_URL=file:./data.db

# Token de autenticação do Turso — deixe vazio para SQLite local
TURSO_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────
# Segredo do JWT — OBRIGATÓRIO, mínimo 32 caracteres
# O servidor se recusa a subir sem um segredo forte.
# Gere um com:  npm run secret
# ─────────────────────────────────────────────────────────────
JWT_SECRET=

# ─────────────────────────────────────────────────────────────
# Código de convite para cadastro
# Sem ele, o cadastro público fica DESATIVADO (crie contas via `npm run create-user`).
# Compartilhe este código só com quem você quer que entre.
# ─────────────────────────────────────────────────────────────
INVITE_CODE=

# ─────────────────────────────────────────────────────────────
# Opcionais
# ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Só necessário se o front for hospedado em outro domínio que o back.
# Vazio = apenas mesma origem (o padrão, mais seguro).
# Aceita vários separados por vírgula: https://a.com,https://b.com
CORS_ORIGIN=
